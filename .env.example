# Public canonical URL (never localhost / pages.dev / Vercel)
NEXT_PUBLIC_SITE_URL=https://vimai.jp

# HMAC secret for admin session cookies. Generate at least 32 random characters.
# Set this as a Cloudflare Pages secret (not a public NEXT_PUBLIC_ var).
AUTH_SECRET=

# First admin user is created on first successful login ONLY when admin_users is empty.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Contact form destination shown in UI
NEXT_PUBLIC_CONTACT_EMAIL=hello@vimai.jp

# Optional public media CDN. Leave empty to serve via /api/media/*
PUBLIC_MEDIA_BASE_URL=

# Cloudflare Web Analytics beacon (public, optional)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Cloudflare GraphQL analytics for the admin dashboard (optional, approximate)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# D1 and R2 are BINDINGS in wrangler.toml / Pages Settings → Bindings.
# Do not put D1/R2 credentials in env strings.
# DB binding: D1 database vimai-cms
# MEDIA binding: R2 bucket vimai-media
