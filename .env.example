# Public canonical URL (never localhost / pages.dev / Vercel)
NEXT_PUBLIC_SITE_URL=https://vimai.jp

# Supabase (Auth, Postgres, Storage). Leave blank for public seed fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form destination shown in UI
NEXT_PUBLIC_CONTACT_EMAIL=hello@vimai.jp

# Supabase Storage bucket for CMS uploads
MEDIA_BUCKET=media

# Cloudflare Web Analytics beacon (public, optional)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Cloudflare GraphQL analytics for the admin dashboard (optional, approximate)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Future R2 seam (not required while using Supabase Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PUBLIC_MEDIA_BASE_URL=
